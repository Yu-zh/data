// The generator's output is its contract, so it is pinned as snapshots.
// `moon test --update` refreshes them; read the diff before accepting it.

///|
fn generate(src : String) -> String raise {
  let (impls, reports) = @parser.parse_string(src)
  if reports.length() > 0 {
    fail("fixture did not parse")
  }
  match emit(scan(impls, "<test>")) {
    Some(code) => @fmt.format(code)
    None => "<nothing>"
  }
}

///|
test "field byte dispatch is rendered as UTF-8" {
  inspect(byte_quote("naïve"), content="b\"na\\xc3\\xafve\"")
  inspect(
    byte_pattern("naïve"),
    content="[0x6e, 0x61, 0xc3, 0xaf, 0x76, 0x65]",
  )
}

///|
test "a record derives both directions" {
  inspect(
    generate(
      (
        #|#data.derive(Serialize, Deserialize)
        #|pub(all) struct Point {
        #|  x : Int
        #|  label : String?
        #|}
      ),
    ),
    content=(
      #|// Generated by `moonx Yu-zh/data/derive`. DO NOT EDIT.
      #|// Re-run the generator after changing the types it was generated from.
      #|
      #|///|
      #|pub impl @data.Serialize for Point with fn serialize(self, serializer) {
      #|  serializer.serialize_struct_begin("Point", 2)
      #|  serializer.serialize_field("x", self.x)
      #|  serializer.serialize_field("label", self.label)
      #|  serializer.serialize_struct_end()
      #|}
      #|
      #|///|
      #|let __data_record_fields_Point : ReadOnlyArray[String] = ["x", "label"]
      #|
      #|///|
      #|priv enum DataRecordFieldPoint {
      #|  Field_x
      #|  Field_label
      #|  Unknown
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataRecordFieldPoint with fn from_index(index) {
      #|  match index {
      #|    0 => Field_x
      #|    1 => Field_label
      #|    _ => Unknown
      #|  }
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataRecordFieldPoint with fn from_bytes(key, index_hint) {
      #|  match index_hint {
      #|    0 if key.equal_to_bytes(b"x") => Field_x
      #|    1 if key.equal_to_bytes(b"label") => Field_label
      #|    _ =>
      #|      match key {
      #|        [0x78] => Field_x
      #|        [0x6c, 0x61, 0x62, 0x65, 0x6c] => Field_label
      #|        _ => Unknown
      #|      }
      #|  }
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataRecordFieldPoint with fn from_string(name) {
      #|  match name {
      #|    "x" => Field_x
      #|    "label" => Field_label
      #|    _ => Unknown
      #|  }
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataRecordFieldPoint with fn name(self) {
      #|  match self {
      #|    Field_x => Some("x")
      #|    Field_label => Some("label")
      #|    Unknown => None
      #|  }
      #|}
      #|
      #|///|
      #|pub impl @data.Deserialize for Point with fn deserialize(deserializer) {
      #|  deserializer.deserialize_struct_begin("Point", __data_record_fields_Point)
      #|  let mut f_x = None
      #|  let mut f_label = None
      #|  while (deserializer.deserialize_field() : DataRecordFieldPoint?) is Some(field) {
      #|    match field {
      #|      Field_x => f_x = Some(deserializer.deserialize_field_value())
      #|      Field_label => f_label = deserializer.deserialize_field_value()
      #|      Unknown => deserializer.skip_value()
      #|    }
      #|  }
      #|  {
      #|    x: match f_x {
      #|      Some(value) => value
      #|      None => @data.required(None, "x", deserializer.path())
      #|    },
      #|    label: f_label,
      #|  }
      #|}
      #|
    ),
  )
}

///|
test "rename and skip change the wire form, not the type" {
  inspect(
    generate(
      (
        #|#data.derive(Serialize, Deserialize)
        #|pub(all) struct Config {
        #|  #data.rename("max-retries")
        #|  max_retries : Int
        #|  #data.skip
        #|  cached : Int
        #|}
      ),
    ),
    content=(
      #|// Generated by `moonx Yu-zh/data/derive`. DO NOT EDIT.
      #|// Re-run the generator after changing the types it was generated from.
      #|
      #|///|
      #|pub impl @data.Serialize for Config with fn serialize(self, serializer) {
      #|  serializer.serialize_struct_begin("Config", 1)
      #|  serializer.serialize_field("max-retries", self.max_retries)
      #|  serializer.serialize_struct_end()
      #|}
      #|
      #|///|
      #|let __data_record_fields_Config : ReadOnlyArray[String] = ["max-retries"]
      #|
      #|///|
      #|priv enum DataRecordFieldConfig {
      #|  Field_max_retries
      #|  Unknown
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataRecordFieldConfig with fn from_index(index) {
      #|  match index {
      #|    0 => Field_max_retries
      #|    _ => Unknown
      #|  }
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataRecordFieldConfig with fn from_bytes(key, index_hint) {
      #|  match index_hint {
      #|    0 if key.equal_to_bytes(b"max-retries") => Field_max_retries
      #|    _ =>
      #|      match key {
      #|        [0x6d, 0x61, 0x78, 0x2d, 0x72, 0x65, 0x74, 0x72, 0x69, 0x65, 0x73] => Field_max_retries
      #|        _ => Unknown
      #|      }
      #|  }
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataRecordFieldConfig with fn from_string(name) {
      #|  match name {
      #|    "max-retries" => Field_max_retries
      #|    _ => Unknown
      #|  }
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataRecordFieldConfig with fn name(self) {
      #|  match self {
      #|    Field_max_retries => Some("max-retries")
      #|    Unknown => None
      #|  }
      #|}
      #|
      #|///|
      #|pub impl @data.Deserialize for Config with fn deserialize(deserializer) {
      #|  deserializer.deserialize_struct_begin("Config", __data_record_fields_Config)
      #|  let mut f_max_retries = None
      #|  while (deserializer.deserialize_field() : DataRecordFieldConfig?) is Some(field) {
      #|    match field {
      #|      Field_max_retries => f_max_retries = Some(deserializer.deserialize_field_value())
      #|      Unknown => deserializer.skip_value()
      #|    }
      #|  }
      #|  {
      #|    max_retries: match f_max_retries {
      #|      Some(value) => value
      #|      None => @data.required(None, "max-retries", deserializer.path())
      #|    },
      #|    cached: Default::default(),
      #|  }
      #|}
      #|
    ),
  )
}

///|
test "all four variant shapes" {
  inspect(
    generate(
      (
        #|#data.derive(Serialize, Deserialize)
        #|pub(all) enum Shape {
        #|  Empty
        #|  Circle(Double)
        #|  Rect(Double, Double)
        #|  Tagged(name~ : String, size~ : Int)
        #|}
      ),
    ),
    content=(
      #|// Generated by `moonx Yu-zh/data/derive`. DO NOT EDIT.
      #|// Re-run the generator after changing the types it was generated from.
      #|
      #|///|
      #|pub impl @data.Serialize for Shape with fn serialize(self, serializer) {
      #|  match self {
      #|    Empty => serializer.serialize_unit_variant(@data.VariantInfo::{ enum_name: "Shape", index: 0, name: "Empty" })
      #|    Circle(v0) => serializer.serialize_newtype_variant(@data.VariantInfo::{ enum_name: "Shape", index: 1, name: "Circle" }, v0)
      #|    Rect(v0, v1) => {
      #|      serializer.serialize_tuple_variant_begin(@data.VariantInfo::{ enum_name: "Shape", index: 2, name: "Rect" }, 2)
      #|      serializer.serialize_tuple_variant_element(v0)
      #|      serializer.serialize_tuple_variant_element(v1)
      #|      serializer.serialize_tuple_variant_end()
      #|    }
      #|    Tagged(name=v0, size=v1) => {
      #|      serializer.serialize_struct_variant_begin(@data.VariantInfo::{ enum_name: "Shape", index: 3, name: "Tagged" }, 2)
      #|      serializer.serialize_struct_variant_field("name", v0)
      #|      serializer.serialize_struct_variant_field("size", v1)
      #|      serializer.serialize_struct_variant_end()
      #|    }
      #|  }
      #|}
      #|
      #|///|
      #|let __data_variant_fields_Shape_3 : ReadOnlyArray[String] = ["name", "size"]
      #|
      #|///|
      #|priv enum DataVariantFieldShape3 {
      #|  Field_name
      #|  Field_size
      #|  Unknown
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataVariantFieldShape3 with fn from_index(index) {
      #|  match index {
      #|    0 => Field_name
      #|    1 => Field_size
      #|    _ => Unknown
      #|  }
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataVariantFieldShape3 with fn from_bytes(key, index_hint) {
      #|  match index_hint {
      #|    0 if key.equal_to_bytes(b"name") => Field_name
      #|    1 if key.equal_to_bytes(b"size") => Field_size
      #|    _ =>
      #|      match key {
      #|        [0x6e, 0x61, 0x6d, 0x65] => Field_name
      #|        [0x73, 0x69, 0x7a, 0x65] => Field_size
      #|        _ => Unknown
      #|      }
      #|  }
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataVariantFieldShape3 with fn from_string(name) {
      #|  match name {
      #|    "name" => Field_name
      #|    "size" => Field_size
      #|    _ => Unknown
      #|  }
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataVariantFieldShape3 with fn name(self) {
      #|  match self {
      #|    Field_name => Some("name")
      #|    Field_size => Some("size")
      #|    Unknown => None
      #|  }
      #|}
      #|
      #|///|
      #|pub impl @data.Deserialize for Shape with fn deserialize(deserializer) {
      #|  let variants = ["Empty", "Circle", "Rect", "Tagged"]
      #|  let value = match deserializer.deserialize_enum_begin("Shape", variants) {
      #|    0 => {
      #|      deserializer.deserialize_unit_variant()
      #|      Empty
      #|    }
      #|    1 => Circle(deserializer.deserialize_newtype_variant())
      #|    2 => {
      #|      deserializer.deserialize_tuple_begin(2)
      #|      let v0 = deserializer.deserialize_tuple_next()
      #|      let v1 = deserializer.deserialize_tuple_next()
      #|      deserializer.deserialize_tuple_end()
      #|      Rect(v0, v1)
      #|    }
      #|    3 => {
      #|      deserializer.deserialize_struct_begin("Tagged", __data_variant_fields_Shape_3)
      #|      let mut f_name = None
      #|      let mut f_size = None
      #|      while (deserializer.deserialize_field() : DataVariantFieldShape3?) is Some(field) {
      #|        match field {
      #|          Field_name => f_name = Some(deserializer.deserialize_field_value())
      #|          Field_size => f_size = Some(deserializer.deserialize_field_value())
      #|          Unknown => deserializer.skip_value()
      #|        }
      #|      }
      #|      Tagged(
      #|        name=match f_name {
      #|          Some(value) => value
      #|          None => @data.required(None, "name", deserializer.path())
      #|        },
      #|        size=match f_size {
      #|          Some(value) => value
      #|          None => @data.required(None, "size", deserializer.path())
      #|        },
      #|      )
      #|    }
      #|    index =>
      #|      raise @data.UnknownVariant(path=deserializer.path(), variant=index.to_string(), expected=variants)
      #|  }
      #|  deserializer.deserialize_enum_end()
      #|  value
      #|}
      #|
    ),
  )
}

///|
test "generic types get a bound per parameter" {
  inspect(
    generate(
      (
        #|#data.derive(Serialize, Deserialize)
        #|pub(all) struct Pair[A, B] {
        #|  first : A
        #|  second : B
        #|}
      ),
    ),
    content=(
      #|// Generated by `moonx Yu-zh/data/derive`. DO NOT EDIT.
      #|// Re-run the generator after changing the types it was generated from.
      #|
      #|///|
      #|pub impl[A : @data.Serialize, B : @data.Serialize] @data.Serialize for Pair[A, B] with fn serialize(self, serializer) {
      #|  serializer.serialize_struct_begin("Pair", 2)
      #|  serializer.serialize_field("first", self.first)
      #|  serializer.serialize_field("second", self.second)
      #|  serializer.serialize_struct_end()
      #|}
      #|
      #|///|
      #|let __data_record_fields_Pair : ReadOnlyArray[String] = ["first", "second"]
      #|
      #|///|
      #|priv enum DataRecordFieldPair {
      #|  Field_first
      #|  Field_second
      #|  Unknown
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataRecordFieldPair with fn from_index(index) {
      #|  match index {
      #|    0 => Field_first
      #|    1 => Field_second
      #|    _ => Unknown
      #|  }
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataRecordFieldPair with fn from_bytes(key, index_hint) {
      #|  match index_hint {
      #|    0 if key.equal_to_bytes(b"first") => Field_first
      #|    1 if key.equal_to_bytes(b"second") => Field_second
      #|    _ =>
      #|      match key {
      #|        [0x66, 0x69, 0x72, 0x73, 0x74] => Field_first
      #|        [0x73, 0x65, 0x63, 0x6f, 0x6e, 0x64] => Field_second
      #|        _ => Unknown
      #|      }
      #|  }
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataRecordFieldPair with fn from_string(name) {
      #|  match name {
      #|    "first" => Field_first
      #|    "second" => Field_second
      #|    _ => Unknown
      #|  }
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataRecordFieldPair with fn name(self) {
      #|  match self {
      #|    Field_first => Some("first")
      #|    Field_second => Some("second")
      #|    Unknown => None
      #|  }
      #|}
      #|
      #|///|
      #|pub impl[A : @data.Deserialize, B : @data.Deserialize] @data.Deserialize for Pair[A, B] with fn deserialize(deserializer) {
      #|  deserializer.deserialize_struct_begin("Pair", __data_record_fields_Pair)
      #|  let mut f_first = None
      #|  let mut f_second = None
      #|  while (deserializer.deserialize_field() : DataRecordFieldPair?) is Some(field) {
      #|    match field {
      #|      Field_first => f_first = Some(deserializer.deserialize_field_value())
      #|      Field_second => f_second = Some(deserializer.deserialize_field_value())
      #|      Unknown => deserializer.skip_value()
      #|    }
      #|  }
      #|  {
      #|    first: match f_first {
      #|      Some(value) => value
      #|      None => @data.required(None, "first", deserializer.path())
      #|    },
      #|    second: match f_second {
      #|      Some(value) => value
      #|      None => @data.required(None, "second", deserializer.path())
      #|    },
      #|  }
      #|}
      #|
    ),
  )
}

///|
test "a tuple struct rides the tuple-struct protocol" {
  inspect(
    generate(
      (
        #|#data.derive(Serialize, Deserialize)
        #|pub(all) struct Rgb(Int, Int, Int)
      ),
    ),
    content=(
      #|
      #|// Generated by `moonx Yu-zh/data/derive`. DO NOT EDIT.
      #|// Re-run the generator after changing the types it was generated from.
      #|///|
      #|pub impl @data.Serialize for Rgb with serialize(self, serializer) {
      #|  serializer.serialize_tuple_struct_begin("Rgb", 3)
      #|  serializer.serialize_tuple_struct_field(self.0)
      #|  serializer.serialize_tuple_struct_field(self.1)
      #|  serializer.serialize_tuple_struct_field(self.2)
      #|  serializer.serialize_tuple_struct_end()
      #|}
      #|
      #|///|
      #|pub impl @data.Deserialize for Rgb with deserialize(deserializer) {
      #|  deserializer.deserialize_tuple_struct_begin("Rgb", 3)
      #|  let v0 = deserializer.deserialize_tuple_next()
      #|  let v1 = deserializer.deserialize_tuple_next()
      #|  let v2 = deserializer.deserialize_tuple_next()
      #|  deserializer.deserialize_tuple_end()
      #|  Rgb(v0, v1, v2)
      #|}
      #|
    ),
  )
}

///|
/// One positional field is a newtype struct, not a one-element tuple: the
/// wrapper disappears and the value is written on its own.
test "a one-field tuple struct rides the newtype protocol" {
  inspect(
    generate(
      (
        #|#data.derive(Serialize, Deserialize)
        #|pub(all) struct Meters(Double)
      ),
    ),
    content=(
      #|
      #|// Generated by `moonx Yu-zh/data/derive`. DO NOT EDIT.
      #|// Re-run the generator after changing the types it was generated from.
      #|///|
      #|pub impl @data.Serialize for Meters with serialize(self, serializer) {
      #|  serializer.serialize_newtype_struct("Meters", self.0)
      #|}
      #|
      #|///|
      #|pub impl @data.Deserialize for Meters with deserialize(deserializer) {
      #|  Meters(deserializer.deserialize_newtype_struct("Meters"))
      #|}
      #|
    ),
  )
}

///|
/// A struct with no fields carries nothing, so it rides the unit-struct
/// protocol rather than opening an empty struct.
test "a fieldless struct rides the unit-struct protocol" {
  inspect(
    generate(
      (
        #|#data.derive(Serialize, Deserialize)
        #|pub(all) struct Marker {}
      ),
    ),
    content=(
      #|
      #|// Generated by `moonx Yu-zh/data/derive`. DO NOT EDIT.
      #|// Re-run the generator after changing the types it was generated from.
      #|///|
      #|pub impl @data.Serialize for Marker with serialize(_self, serializer) {
      #|  serializer.serialize_unit_struct("Marker")
      #|}
      #|
      #|///|
      #|pub impl @data.Deserialize for Marker with deserialize(deserializer) {
      #|  deserializer.deserialize_unit_struct("Marker")
      #|  Marker::{  }
      #|}
      #|
    ),
  )
}

///|
/// Skipping every field is not the same as having none: the type still has a
/// shape, so it stays a struct with nothing left to write.
test "a record whose fields are all skipped is still a record" {
  inspect(
    generate(
      (
        #|#data.derive(Serialize, Deserialize)
        #|pub(all) struct Opaque {
        #|  #data.skip
        #|  cached : Int
        #|}
      ),
    ),
    content=(
      #|
      #|// Generated by `moonx Yu-zh/data/derive`. DO NOT EDIT.
      #|// Re-run the generator after changing the types it was generated from.
      #|///|
      #|pub impl @data.Serialize for Opaque with serialize(_self, serializer) {
      #|  serializer.serialize_struct_begin("Opaque", 0)
      #|  serializer.serialize_struct_end()
      #|}
      #|
      #|///|
      #|let __data_record_fields_Opaque :ReadOnlyArray[String] =[]
      #|
      #|///|
      #|priv enum DataRecordFieldOpaque {
      #|  Unknown
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataRecordFieldOpaque with from_index(_index) {
      #|  Unknown
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataRecordFieldOpaque with from_bytes(
      #|  _key,
      #|  _index_hint,
      #|) {
      #|  Unknown
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataRecordFieldOpaque with from_string(_name) {
      #|  Unknown
      #|}
      #|
      #|///|
      #|impl @data.FieldIdentifier for DataRecordFieldOpaque with name(self) {
      #|  match self {
      #|    Unknown => None
      #|  }
      #|}
      #|
      #|///|
      #|pub impl @data.Deserialize for Opaque with deserialize(deserializer) {
      #|  deserializer.deserialize_struct_begin("Opaque", __data_record_fields_Opaque)
      #|  while (deserializer.deserialize_field() : DataRecordFieldOpaque?) is Some(
      #|    field,
      #|  ) {
      #|    match field {
      #|      Unknown => deserializer.skip_value()
      #|    }
      #|  }
      #|  { cached: Default::default(), }
      #|}
      #|
    ),
  )
}

///|
test "deriving only one direction emits only that impl" {
  inspect(
    generate(
      (
        #|#data.derive(Serialize)
        #|pub(all) struct Only {
        #|  a : Int
        #|}
      ),
    ),
    content=(
      #|
      #|// Generated by `moonx Yu-zh/data/derive`. DO NOT EDIT.
      #|// Re-run the generator after changing the types it was generated from.
      #|///|
      #|pub impl @data.Serialize for Only with serialize(self, serializer) {
      #|  serializer.serialize_struct_begin("Only", 1)
      #|  serializer.serialize_field("a", self.a)
      #|  serializer.serialize_struct_end()
      #|}
      #|
    ),
  )
}

///|
test "a private type gets a private impl" {
  inspect(
    generate(
      (
        #|#data.derive(Serialize)
        #|struct Hidden {
        #|  a : Int
        #|}
      ),
    ),
    content=(
      #|
      #|// Generated by `moonx Yu-zh/data/derive`. DO NOT EDIT.
      #|// Re-run the generator after changing the types it was generated from.
      #|///|
      #|impl @data.Serialize for Hidden with serialize(self, serializer) {
      #|  serializer.serialize_struct_begin("Hidden", 1)
      #|  serializer.serialize_field("a", self.a)
      #|  serializer.serialize_struct_end()
      #|}
      #|
    ),
  )
}

///|
test "unmarked types and other namespaces are left alone" {
  inspect(
    generate(
      (
        #|pub(all) struct Plain {
        #|  a : Int
        #|}
        #|
        #|#gobject.subclass(Widget)
        #|pub(all) struct Other {
        #|  b : Int
        #|}
      ),
    ),
    content="<nothing>",
  )
}

///|
/// Attribute mistakes are the generator's main UX surface, so every message is
/// pinned.
fn generate_error(src : String) -> String {
  let (impls, reports) = @parser.parse_string(src)
  if reports.length() > 0 {
    return "<did not parse>"
  }
  try {
    let _ = scan(impls, "<test>")
    "<no error>"
  } catch {
    e => Show::to_string(e)
  }
}

///|
test "malformed #data.derive is rejected with a useful message" {
  inspect(
    generate_error(
      (
        #|#data.derive()
        #|pub(all) struct A { a : Int }
      ),
    ),
    content="<test>: #data.derive on `A` names no traits",
  )
  inspect(
    generate_error(
      (
        #|#data.derive(Show)
        #|pub(all) struct A { a : Int }
      ),
    ),
    content="<test>: cannot derive `Show` for `A`; expected Serialize or Deserialize",
  )
  inspect(
    generate_error(
      (
        #|#data.derive("Serialize")
        #|pub(all) struct A { a : Int }
      ),
    ),
    content="<test>: #data.derive on `A` takes trait names, not literals",
  )
  inspect(
    generate_error(
      (
        #|#data.serialize(A)
        #|pub(all) struct A { a : Int }
      ),
    ),
    content="<test>: unknown attribute `#data.serialize` on type `A`",
  )
}

///|
test "malformed member attributes are rejected" {
  inspect(
    generate_error(
      (
        #|#data.derive(Serialize)
        #|pub(all) struct A {
        #|  #data.rename
        #|  a : Int
        #|}
      ),
    ),
    content="<test>: type `A`: #data.rename on `a` takes exactly one string",
  )
  inspect(
    generate_error(
      (
        #|#data.derive(Serialize)
        #|pub(all) struct A {
        #|  #data.skip(1)
        #|  a : Int
        #|}
      ),
    ),
    content="<test>: type `A`: cannot make sense of attribute `#data.skip(1)`",
  )
  inspect(
    generate_error(
      (
        #|#data.derive(Serialize)
        #|pub(all) struct A {
        #|  #data.skip(always)
        #|  a : Int
        #|}
      ),
    ),
    content="<test>: type `A`: #data.skip on `a` takes no arguments",
  )
  inspect(
    generate_error(
      (
        #|#data.derive(Serialize)
        #|pub(all) struct A {
        #|  #data.flatten
        #|  a : Int
        #|}
      ),
    ),
    content="<test>: type `A`: unknown attribute `#data.flatten` on `a`",
  )
}

///|
test "duplicate serialized field names are rejected" {
  inspect(
    generate_error(
      (
        #|#data.derive(Deserialize)
        #|pub(all) struct A {
        #|  first : Int
        #|  #data.rename("first")
        #|  second : Int
        #|}
      ),
    ),
    content="<test>: type `A`: fields `first` and `second` both serialize as `first`",
  )
}

///|
test "shapes with no data model equivalent are rejected" {
  inspect(
    generate_error(
      (
        #|#data.derive(Serialize)
        #|pub(all) enum E {
        #|  #data.skip
        #|  A
        #|}
      ),
    ),
    content="<test>: type `E`: #data.skip is not supported on enum variants (`A`)",
  )
  inspect(
    generate_error(
      (
        #|#data.derive(Serialize)
        #|pub type A
      ),
    ),
    content="<test>: `A` is not a struct or enum, so there is nothing to derive",
  )
}

///|
/// `moon` decides a file's package from its name, so a generated companion has
/// to keep the test suffix or it lands in the wrong package.
test "generated files are named so they stay in the right package" {
  inspect(output_path("types.mbt"), content="types_derive.mbt")
  inspect(output_path("a/b/types.mbt"), content="a/b/types_derive.mbt")
  inspect(output_path("data_test.mbt"), content="data_derive_test.mbt")
  inspect(output_path("data_wbtest.mbt"), content="data_derive_wbtest.mbt")
}

///|
test "the generator never reads its own output back in" {
  assert_true(is_generated("types_derive.mbt"))
  assert_true(is_generated("data_derive_test.mbt"))
  assert_true(is_generated("data_derive_wbtest.mbt"))
  assert_false(is_generated("types.mbt"))
  assert_false(is_generated("data_test.mbt"))
}

///|
test "build and vendor directories are skipped" {
  assert_true(skip_dir("target"))
  assert_true(skip_dir(".mooncakes"))
  assert_true(skip_dir(".git"))
  assert_false(skip_dir("example"))
  assert_false(skip_dir("json"))
}

///|
/// The fingerprint has to see through exactly what `moon fmt` changes — line
/// breaks and the trailing comma it adds when it wraps — and nothing more.
test "the fingerprint ignores layout but not content" {
  let flat = "f(a, b)"
  let wrapped =
    #|f(
    #|  a,
    #|  b,
    #|)
  assert_eq(fingerprint(flat), fingerprint(wrapped))
  assert_not_eq(fingerprint("f(a, b)"), fingerprint("f(a, c)"))
  assert_not_eq(fingerprint("f(a)"), fingerprint("f(a, b)"))
}

///|
test "attributes in other namespaces pass straight through" {
  // The compiler ignores unknown namespaced attributes, and so must the
  // generator — another tool may own them.
  inspect(
    generate(
      (
        #|#data.derive(Serialize)
        #|pub(all) struct A {
        #|  #other.skip
        #|  a : Int
        #|}
      ),
    ).contains("serialize_field(\"a\", self.a)"),
    content="true",
  )
}

///|
test "a labelled attribute argument is accepted" {
  inspect(
    generate(
      (
        #|#data.derive(Serialize)
        #|pub(all) struct A {
        #|  #data.rename(to="b")
        #|  a : Int
        #|}
      ),
    ).contains("serialize_field(\"b\", self.a)"),
    content="true",
  )
}

///|
test "rename rejects a non-string argument" {
  inspect(
    generate_error(
      (
        #|#data.derive(Serialize)
        #|pub(all) struct A {
        #|  #data.rename(b)
        #|  a : Int
        #|}
      ),
    ),
    content="<test>: type `A`: #data.rename on `a` takes exactly one string",
  )
}

///|
test "an unparseable attribute on a type is reported, not ignored" {
  inspect(
    generate_error(
      (
        #|#data.derive(1)
        #|pub(all) struct A { a : Int }
      ),
    ),
    content="<test>: cannot make sense of attribute `#data.derive(1)`",
  )
}

///|
test "a variant mixing labelled and positional payloads is rejected" {
  inspect(
    generate_error(
      (
        #|#data.derive(Serialize)
        #|pub(all) enum E {
        #|  Mixed(Int, name~ : String)
        #|}
      ),
    ),
    content="<test>: type `E`: variant `Mixed` mixes labelled and positional payloads, which has no data model equivalent",
  )
}
