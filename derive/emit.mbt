// Rendering `Target`s as MoonBit source.
//
// Two naming conventions keep generated code from colliding with the user's
// own names: the trait method parameters are `serializer` / `deserializer`
// rather than `s` / `d`, and accumulators are prefixed `f_`. Labelled variant
// payloads are bound with explicit `label=binding` patterns for the same
// reason — a variant field called `deserializer` would otherwise shadow it.

///|
/// The banner every generated file opens with.
pub const HEADER : String = "// Generated by `moonx Yu-zh/data/derive`. DO NOT EDIT.\n// Re-run the generator after changing the types it was generated from."

///|
fn Target::self_type(self : Target) -> String {
  if self.params.is_empty() {
    self.name
  } else {
    "\{self.name}[\{self.params.join(", ")}]"
  }
}

///|
/// `pub impl[T : @data.Serialize] @data.Serialize for Foo[T]`
fn Target::impl_head(self : Target, trait_ : String) -> String {
  let visibility = if self.public { "pub " } else { "" }
  let bounds = if self.params.is_empty() {
    ""
  } else {
    let each = self.params.map(p => "\{p} : @data.\{trait_}")
    "[\{each.join(", ")}]"
  }
  "\{visibility}impl\{bounds} @data.\{trait_} for \{self.self_type()}"
}

///|
fn quote(text : String) -> String {
  let out = StringBuilder::new()
  out.write_char('"')
  for c in text {
    match c {
      '"' => out.write_string("\\\"")
      '\\' => out.write_string("\\\\")
      '\n' => out.write_string("\\n")
      _ => out.write_char(c)
    }
  }
  out.write_char('"')
  out.to_string()
}

///|
fn name_list(fields : Array[Field]) -> String {
  let names = fields.filter(f => !f.skip).map(f => quote(f.name))
  "[\{names.join(", ")}]"
}

///|
fn variant_info(target : Target, index : Int, case_ : Case) -> String {
  "@data.VariantInfo::{ enum_name: \{quote(target.name)}, index: \{index}, name: \{quote(case_.name)} }"
}

///|
/// Writes the body that reads a set of named fields into `f_*` accumulators.
///
/// Shared by structs and struct-shaped enum variants, which differ only in
/// what they build at the end.
fn write_field_loop(
  out : StringBuilder,
  fields : Array[Field],
  indent : String,
) -> Unit {
  for field in fields {
    if !field.skip {
      out.write_string("\{indent}let mut f_\{field.ident} = None\n")
    }
  }
  out.write_string(
    "\{indent}while deserializer.deserialize_field_name() is Some(field) {\n",
  )
  out.write_string("\{indent}  match field {\n")
  for field in fields {
    if field.skip {
      continue
    }
    // An `Option` field takes the read straight, so an absent field and an
    // explicit null both land on `None`. Everything else is wrapped so that
    // absence stays distinguishable and can be reported by name.
    let rhs = if field.optional {
      "deserializer.deserialize_field_value()"
    } else {
      "Some(deserializer.deserialize_field_value())"
    }
    out.write_string(
      "\{indent}    \{quote(field.name)} => f_\{field.ident} = \{rhs}\n",
    )
  }
  out.write_string("\{indent}    _ => deserializer.skip_value()\n")
  out.write_string("\{indent}  }\n")
  out.write_string("\{indent}}\n")
}

///|
fn field_value(field : Field) -> String {
  if field.skip {
    "Default::default()"
  } else if field.optional {
    "f_\{field.ident}"
  } else {
    "@data.required(f_\{field.ident}, \{quote(field.name)}, deserializer.path())"
  }
}

///|
fn write_serialize(out : StringBuilder, target : Target) -> Unit {
  out.write_string("\n///|\n")
  out.write_string(
    "\{target.impl_head("Serialize")} with fn serialize(self, serializer) {\n",
  )
  match target.shape {
    Record(fields) => {
      let kept = fields.filter(f => !f.skip)
      out.write_string(
        "  serializer.serialize_struct_begin(\{quote(target.name)}, \{kept.length()})\n",
      )
      for field in kept {
        out.write_string(
          "  serializer.serialize_field(\{quote(field.name)}, self.\{field.ident})\n",
        )
      }
      out.write_string("  serializer.serialize_struct_end()\n")
    }
    TupleStruct(arity) => {
      out.write_string(
        "  serializer.serialize_tuple_struct_begin(\{quote(target.name)}, \{arity})\n",
      )
      for i in 0..<arity {
        out.write_string(
          "  serializer.serialize_tuple_struct_field(self.\{i})\n",
        )
      }
      out.write_string("  serializer.serialize_tuple_struct_end()\n")
    }
    Variant(cases) => {
      out.write_string("  match self {\n")
      for index, case_ in cases {
        let info = variant_info(target, index, case_)
        match case_.payload {
          Unit =>
            out.write_string(
              "    \{case_.ident} => serializer.serialize_unit_variant(\{info})\n",
            )
          Newtype =>
            out.write_string(
              "    \{case_.ident}(v0) => serializer.serialize_newtype_variant(\{info}, v0)\n",
            )
          Tuple(arity) => {
            let binds = Array::makei(arity, i => "v\{i}")
            out.write_string("    \{case_.ident}(\{binds.join(", ")}) => {\n")
            out.write_string(
              "      serializer.serialize_tuple_variant_begin(\{info}, \{arity})\n",
            )
            for bind in binds {
              out.write_string(
                "      serializer.serialize_tuple_variant_element(\{bind})\n",
              )
            }
            out.write_string("      serializer.serialize_tuple_variant_end()\n")
            out.write_string("    }\n")
          }
          Struct(fields) => {
            let binds = fields.mapi((i, f) => "\{f.ident}=v\{i}")
            out.write_string("    \{case_.ident}(\{binds.join(", ")}) => {\n")
            out.write_string(
              "      serializer.serialize_struct_variant_begin(\{info}, \{fields.length()})\n",
            )
            for i, field in fields {
              out.write_string(
                "      serializer.serialize_struct_variant_field(\{quote(field.name)}, v\{i})\n",
              )
            }
            out.write_string(
              "      serializer.serialize_struct_variant_end()\n",
            )
            out.write_string("    }\n")
          }
        }
      }
      out.write_string("  }\n")
    }
  }
  out.write_string("}\n")
}

///|
fn write_deserialize(out : StringBuilder, target : Target) -> Unit {
  out.write_string("\n///|\n")
  out.write_string(
    "\{target.impl_head("Deserialize")} with fn deserialize(deserializer) {\n",
  )
  match target.shape {
    Record(fields) => {
      out.write_string(
        "  deserializer.deserialize_struct_begin(\{quote(target.name)}, \{name_list(fields)})\n",
      )
      write_field_loop(out, fields, "  ")
      out.write_string("  {\n")
      for field in fields {
        out.write_string("    \{field.ident}: \{field_value(field)},\n")
      }
      out.write_string("  }\n")
    }
    TupleStruct(arity) => {
      out.write_string(
        "  deserializer.deserialize_tuple_struct_begin(\{quote(target.name)}, \{arity})\n",
      )
      for i in 0..<arity {
        out.write_string(
          "  let v\{i} = deserializer.deserialize_tuple_next()\n",
        )
      }
      out.write_string("  deserializer.deserialize_tuple_end()\n")
      let binds = Array::makei(arity, i => "v\{i}")
      out.write_string("  \{target.name}(\{binds.join(", ")})\n")
    }
    Variant(cases) => {
      let names = cases.map(c => quote(c.name))
      out.write_string("  let variants = [\{names.join(", ")}]\n")
      out.write_string(
        "  let value = match deserializer.deserialize_enum_begin(\{quote(target.name)}, variants) {\n",
      )
      for case_ in cases {
        match case_.payload {
          Unit => {
            out.write_string("    \{quote(case_.name)} => {\n")
            out.write_string("      deserializer.deserialize_unit_variant()\n")
            out.write_string("      \{case_.ident}\n")
            out.write_string("    }\n")
          }
          Newtype =>
            out.write_string(
              "    \{quote(case_.name)} => \{case_.ident}(deserializer.deserialize_newtype_variant())\n",
            )
          Tuple(arity) => {
            out.write_string("    \{quote(case_.name)} => {\n")
            out.write_string(
              "      deserializer.deserialize_tuple_begin(\{arity})\n",
            )
            for i in 0..<arity {
              out.write_string(
                "      let v\{i} = deserializer.deserialize_tuple_next()\n",
              )
            }
            out.write_string("      deserializer.deserialize_tuple_end()\n")
            let binds = Array::makei(arity, i => "v\{i}")
            out.write_string("      \{case_.ident}(\{binds.join(", ")})\n")
            out.write_string("    }\n")
          }
          Struct(fields) => {
            out.write_string("    \{quote(case_.name)} => {\n")
            out.write_string(
              "      deserializer.deserialize_struct_begin(\{quote(case_.name)}, \{name_list(fields)})\n",
            )
            write_field_loop(out, fields, "      ")
            let binds = fields.map(f => "\{f.ident}=\{field_value(f)}")
            out.write_string("      \{case_.ident}(\{binds.join(", ")})\n")
            out.write_string("    }\n")
          }
        }
      }
      out.write_string(
        "    other =>\n      raise @data.UnknownVariant(path=deserializer.path(), variant=other, expected=variants)\n",
      )
      out.write_string("  }\n")
      out.write_string("  deserializer.deserialize_enum_end()\n")
      out.write_string("  value\n")
    }
  }
  out.write_string("}\n")
}

///|
/// Renders every impl for one file's worth of targets, or `None` when nothing
/// in the file was marked.
pub fn emit(targets : Array[Target]) -> String? {
  let wanted = targets.filter(t => t.serialize || t.deserialize)
  if wanted.is_empty() {
    return None
  }
  let out = StringBuilder::new()
  out.write_string(HEADER)
  out.write_string("\n")
  for target in wanted {
    if target.serialize {
      write_serialize(out, target)
    }
    if target.deserialize {
      write_deserialize(out, target)
    }
  }
  Some(out.to_string())
}
